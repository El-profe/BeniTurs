# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO - BENITURS / TRINIDAD TURISMO
# ==============================================================================
# Copia este archivo como .env y edita los valores correspondientes.
# NUNCA subas el archivo .env real con contraseñas a Git o repositorios públicos.

# ------------------------------------------------------------------------------
# 1. Configuración General de la Aplicación
# ------------------------------------------------------------------------------
# Entorno: 'local' (muestra errores detallados) o 'production' (oculta errores y activa logs)
APP_ENV=production
APP_DEBUG=false

# URL base pública del sitio web:
# En local (Laragon): http://localhost/trinidad_turismo/public
# En InfinityFree:    http://tudominio.infinityfreeapp.com (o https:// si activas SSL)
# Si se deja vacío, la aplicación detectará automáticamente el protocolo y dominio actual.
BENITURS_BASE_URL=

# ------------------------------------------------------------------------------
# 2. Conexión a Base de Datos MariaDB / MySQL
# ------------------------------------------------------------------------------
# Para Laragon / Local:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=benitours
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4

# Para InfinityFree (Reemplazar con los datos de tu panel vPanel):
DB_HOST=sql307.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_43004275_XXX
DB_USERNAME=if0_43004275
DB_PASSWORD=9w1StrdIAC9qP
DB_CHARSET=utf8mb4
# ------------------------------------------------------------------------------
# 3. Integración Comercial y Notificaciones
# ------------------------------------------------------------------------------
BENITURS_BANCO="Banco Unión S.A."
BENITURS_TITULAR="BeniTurs Turismo"
BENITURS_CUENTA="10000012345678"
BENITURS_QR_URL=""

# Telegram: 'false' para InfinityFree (desactivado de forma limpia)
# Cambiar a 'true' cuando migres a un servidor VPS de pago
TELEGRAM_ACTIVO=false
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_ADMIN_LOCAL_ID=1
TELEGRAM_WEBHOOK_SECRET=""
BENITURS_CREDENTIAL_KEY=""
