# trinidad_turismo/.htaccess
# Configuración perimetral de seguridad para Apache (Local Laragon y Servidor de Producción / InfinityFree)

# Desactivar listado de directorios
Options -Indexes

# Proteger archivos ocultos (.env, .git, etc.) contra acceso HTTP directo
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear el acceso directo a carpetas sensibles desde el navegador
    RewriteRule ^(app|config|database|storage|docs)(/.*)?$ - [F,L,NC]

    # Redirigir el acceso a la carpeta public/ de forma agnóstica
    # Funciona tanto si está en la raíz de un dominio (InfinityFree) como en una subcarpeta (Laragon)
    RewriteCond %{REQUEST_URI} !^/(.*)/public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>